{
    "compilerOptions": {
        "baseUrl": ".",
        "paths": {
            "@/components/*": ["components/*"],
            "@/ui/*": ["components/ui/*"],
            "@/lib/*": ["./lib/*"],
            "@/context/*": ["./context/*"],
            "@/utils/*": ["./utils/*"],
            "@/styles/*": ["styles/*"],
            "@/hooks/*": ["hooks/*"],
